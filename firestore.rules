rules_version = '2';

// O primeiro administrador é criado em /admin/login.
// O documento meta/bootstrap impede que outra conta se promova depois.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validProduct(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() < 160
        && data.slug is string
        && data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && data.price is number
        && data.price >= 0
        && (data.promotionalPrice == null || (data.promotionalPrice is number && data.promotionalPrice >= 0))
        && data.active is bool
        && data.featured is bool
        && data.isNew is bool
        && data.categoryId is string
        && data.images is list
        && data.images.size() < 12
        && data.tags is list
        && (!('stock' in data) || data.stock == null || (data.stock is int && data.stock >= 0));
    }

    function validCategory(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() < 80
        && data.slug is string
        && data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && data.active is bool
        && data.order is number;
    }

    function validBanner(data) {
      return data.title is string
        && data.title.size() < 140
        && data.active is bool
        && data.order is number
        && data.image is string;
    }

    function validAdminUser(data) {
      return data.role == 'admin'
        && data.email is string
        && data.email.size() > 3
        && data.email.size() < 200;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow create: if isAdmin() && validAdminUser(request.resource.data)
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == request.auth.token.email
          && validAdminUser(request.resource.data)
          && !exists(/databases/$(database)/documents/meta/bootstrap));
      allow update: if isAdmin() && validAdminUser(request.resource.data);
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow get: if isAdmin();
      allow create: if signedIn()
        && docId == 'bootstrap'
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/meta/bootstrap);
      allow update, delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validBanner(request.resource.data);
      allow delete: if isAdmin();
    }

    function validTestimonial(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() < 80
        && data.text is string
        && data.text.size() > 0
        && data.text.size() < 800
        && data.detail is string
        && data.detail.size() < 120
        && data.active is bool
        && data.order is number;
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && validTestimonial(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'store';
      allow delete: if false;
    }
  }
}
